PROCRASTINATOR_DATABASE_URL=postgres://procrastinator:procrastinator@localhost:5432/procrastinator?sslmode=disable
PROCRASTINATOR_HTTP_ADDR=:8080
PROCRASTINATOR_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
PROCRASTINATOR_LLM_API_KEY=your-api-key-here
PROCRASTINATOR_LLM_MODEL=gemma-4-26b-a4b-it
PROCRASTINATOR_STORAGE_DIR=./storage
PROCRASTINATOR_MAX_UPLOAD_BYTES=20971520
PROCRASTINATOR_LLM_TIMEOUT=60s
PROCRASTINATOR_INGEST_REVIEW_THRESHOLD=0.7
# Basic Auth credentials — REQUIRED. Server fails fast at startup if absent or invalid.
# Value: JSON array of {"user","pass"} objects (no extra keys per object).
#   pairs:  1–16
#   user:   1–64 UTF-8 characters
#   pass:   8–128 UTF-8 characters
PROCRASTINATOR_BASIC_AUTH_USERS=[{"user":"app","pass":"s3cret!"}]
