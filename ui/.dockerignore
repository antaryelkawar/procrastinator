# Keep the Docker build context lean and prevent secrets/dev artifacts from
# entering image layers. Everything the build NEEDS (package.json,
# package-lock.json, components.json, src/, public/, index.html, vite.config.ts,
# tsconfig*.json, nginx.conf, Dockerfile) is NOT listed here.

# Dependency tree is installed fresh via `npm ci` in the build stage.
node_modules/

# Stale build output — regenerated by `npm run build` inside the image.
dist/

# Dev/runtime logs (vite, dev-server, smoke tests).
*.log

# Local scratch / temp workspace.
.tmp/

# Environment files may contain secrets — never ship them.
.env

# Local-only config overrides (e.g. vite.config.ts.local, *.env.local).
*.local

# TypeScript incremental build info — regenerated by `tsc -b`.
*.tsbuildinfo

# Local dev launchers (Windows), not needed in the image.
run-vite.cmd
start-vite.ps1
