# Set to "true" to mock API responses with MSW (standalone UI work without backend)
VITE_USE_MSW=true

# Basic Auth transport credentials — REQUIRED for the UI to talk to the API.
# Sent as `Authorization: Basic <base64(user:pass)>` on every request, built by
# ui/src/lib/api/auth.ts (basicAuthHeader()).
# Both are VITE_-prefixed so Vite inlines them as build-time vars into the bundle.
# They are an application-level shared secret baked into the bundle, NOT per-user
# credentials — the exposure model (anyone who loads the bundle can read them)
# is accepted by design. If either is missing/empty the UI fails fast at startup
# (auth.ts throws naming the missing var) and makes no request with empty credentials.
VITE_API_BASIC_AUTH_USER=app
VITE_API_BASIC_AUTH_PASSWORD=s3cret!
